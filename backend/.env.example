# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verkeersboete

# Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Application
SECRET_KEY=your-secret-key-here
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated

# OCR Configuration (tesseract or google_vision)
OCR_ENGINE=tesseract

# Google Cloud Vision (optional, if OCR_ENGINE=google_vision)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
